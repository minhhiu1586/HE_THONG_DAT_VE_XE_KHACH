# Application
APP_NAME=HE_THONG_DAT_VE_XE_KHACH
APP_ENV=development
APP_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false
# VNPay sandbox; obtain merchant credentials locally, never commit the secret.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_RETURN_URL=http://localhost:3000/thanh-toan/return
# Vehicle preparation only; does not certify driver rest.
VEHICLE_TURNAROUND_MINUTES=30
# T12 project default: stop accepting new bookings this many minutes before departure.
TRIP_BOOKING_CUTOFF_MINUTES=60

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api
BACKEND_URL=http://127.0.0.1:8080

# Database
POSTGRES_DB=datvexe
POSTGRES_USER=datvexe_user
# Replace with a unique local password before first startup.
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/datvexe

# Security
# Current authentication uses a server-side session cookie; no JWT secret is read.

# Transactional receipt email (backend only)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Vexexin - Hỗ trợ khách hàng
EMAIL_NOTIFICATIONS_ENABLED=true
