{
  "openapi": "3.1.0",
  "info": {
    "title": "Booking and Order API (T16)",
    "version": "0.1.0-draft",
    "description": "Module contract for session-owned seat holds and booking orders. Passenger drafts live only in the servlet HTTP session until T17 issuance; no ticket row is created for them. See booking-order.md for lifecycle, migration, and smoke instructions."
  },
  "servers": [{"url": "/"}],
  "tags": [{"name": "T16 Booking", "description": "Customer seat hold and order lifecycle."}],
  "security": [{"cookieAuth": []}],
  "paths": {
    "/api/booking/hold": {
      "post": {
        "tags": ["T16 Booking"],
        "operationId": "holdSeatsAndCreateOrder",
        "summary": "B01 Hold seats and create a draft order",
        "description": "KHACH_HANG only. The authenticated session owns the order. Hold every requested seat atomically for 15 minutes; expiry is evaluated at now >= thoiDiemHetHan.",
        "x-roles": ["KHACH_HANG"],
        "parameters": [{"$ref": "#/components/parameters/CsrfToken"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HoldRequest"}, "example": {"maChuyen": "CX01", "danhSachMaGhe": ["G11", "G12"]}}}
        },
        "responses": {
          "201": {"description": "Order and holds created atomically.", "headers": {"Location": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HoldSeatResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/api/booking/{maDon}": {
      "parameters": [{"$ref": "#/components/parameters/MaDon"}],
      "get": {
        "tags": ["T16 Booking"],
        "operationId": "getBookingOrder",
        "summary": "B02/B05 Get an order and its current preview",
        "description": "KHACH_HANG only; the caller must own the order. Passenger data is returned only when this authenticated account and order have a snapshot in the current JSESSIONID. A new servlet session still loads the persisted order and holds, with hanhKhach=[] and coTheChotGia=false. Paid orders remain readable; maChuyen is derived from holds or tickets. Historical orders without holds may have thoiDiemBatDau and thoiDiemHetHan null. A GET reports an invalid selected promotion without clearing it from storage. When expiry is first detected, it commits the hold and order as HET_HAN and returns 409 HOLD_EXPIRED.",
        "x-roles": ["KHACH_HANG"],
        "responses": {
          "200": {"description": "Current order, holds, issued tickets, and price preview.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderResponse"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      },
      "patch": {
        "tags": ["T16 Booking"],
        "operationId": "patchBookingContact",
        "summary": "B03 Update order contact fields",
        "description": "KHACH_HANG only; owner access. Only khachDatTen, khachDatSoDienThoai, and ghiChu are accepted. At least one field is required. PATCH does not extend the hold. PostgreSQL stores a redacted idempotency response with hanhKhach=[] and coTheChotGia=false. A complete response replay is available only if the full response cache was written and remains in the current HTTP session. The cache may be absent after a crash between database commit and the session write, or after session loss; retry then returns the redacted database order state. Read the order to verify the current session snapshot or re-enter passengers if the session was lost.",
        "x-roles": ["KHACH_HANG"],
        "parameters": [{"$ref": "#/components/parameters/CsrfToken"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ContactPatch"}, "example": {"khachDatTen": "Nguyen Van A", "khachDatSoDienThoai": "0900000001", "ghiChu": null}}}},
        "responses": {
          "200": {"description": "Updated order.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/api/booking/{maDon}/hanh-khach": {
      "parameters": [{"$ref": "#/components/parameters/MaDon"}],
      "put": {
        "tags": ["T16 Booking"],
        "operationId": "replaceBookingPassengers",
        "summary": "B04 Save all passengers for held seats",
        "description": "KHACH_HANG only; owner access. The submitted unique seat IDs must exactly match all current holds. Validate the full list before replacing the normalized passenger snapshot in the current JSESSIONID. Passenger data is not written to ve_xe or another passenger table.",
        "x-roles": ["KHACH_HANG"],
        "parameters": [{"$ref": "#/components/parameters/CsrfToken"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PassengerUpdate"}, "example": {"hanhKhach": [{"maGhe": "G11", "hoTen": "Nguyen Van A", "soDienThoai": "0900000001", "cccd": null}]}}}},
        "responses": {
          "200": {"description": "Order with normalized passengers retained in the current HTTP session; danhSachVe remains empty before issuance.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/api/booking/{maDon}/ghe/{maGhe}": {
      "parameters": [{"$ref": "#/components/parameters/MaDon"}, {"$ref": "#/components/parameters/MaGhe"}],
      "delete": {
        "tags": ["T16 Booking"],
        "operationId": "dropBookingSeat",
        "summary": "B08a Drop a held seat",
        "description": "KHACH_HANG only; owner access. Remove the passenger for this seat from the current HTTP session. Dropping the last held seat ends the draft order as DA_HUY and clears its passenger snapshot.",
        "x-roles": ["KHACH_HANG"],
        "parameters": [{"$ref": "#/components/parameters/CsrfToken"}],
        "responses": {
          "200": {"description": "Updated order.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderResponse"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/api/booking/{maDon}/doi-ghe": {
      "parameters": [{"$ref": "#/components/parameters/MaDon"}],
      "put": {
        "tags": ["T16 Booking"],
        "operationId": "swapBookingSeat",
        "summary": "B08b Change one held seat",
        "description": "KHACH_HANG only; owner access. The old hold is released and new hold is created atomically. Move the passenger maGhe to the new seat while preserving passenger fields. A failed swap leaves the old hold and session snapshot unchanged.",
        "x-roles": ["KHACH_HANG"],
        "parameters": [{"$ref": "#/components/parameters/CsrfToken"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SeatSwapRequest"}, "example": {"maGheCu": "G11", "maGheMoi": "G13"}}}},
        "responses": {
          "200": {"description": "Updated order.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/api/booking/{maDon}/khuyen-mai": {
      "parameters": [{"$ref": "#/components/parameters/MaDon"}],
      "put": {
        "tags": ["T16 Booking"],
        "operationId": "selectBookingPromotion",
        "summary": "B08c Select a promotion for preview",
        "description": "KHACH_HANG only; owner access. Selection does not reserve quota or round preview amounts. Use DELETE on this resource to remove the selected code.",
        "x-roles": ["KHACH_HANG"],
        "parameters": [{"$ref": "#/components/parameters/CsrfToken"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PromotionSelection"}, "example": {"maKhuyenMai": "KM10"}}}},
        "responses": {
          "200": {"description": "Updated order and price preview.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      },
      "delete": {
        "tags": ["T16 Booking"],
        "operationId": "removeBookingPromotion",
        "summary": "B08d Remove selected promotion",
        "description": "KHACH_HANG only; owner access.",
        "x-roles": ["KHACH_HANG"],
        "parameters": [{"$ref": "#/components/parameters/CsrfToken"}],
        "responses": {
          "200": {"description": "Updated order and price preview.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderResponse"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/api/booking/{maDon}/huy": {
      "parameters": [{"$ref": "#/components/parameters/MaDon"}],
      "post": {
        "tags": ["T16 Booking"],
        "operationId": "cancelBookingOrder",
        "summary": "B07 Cancel a draft order",
        "description": "KHACH_HANG only; owner access. The JSON body is optional; send {} when a body is required by the client. Repeated cancellation of the same order is idempotent and clears passenger data from the current HTTP session.",
        "x-roles": ["KHACH_HANG"],
        "parameters": [{"$ref": "#/components/parameters/CsrfToken"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": false, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}, "example": {}}}},
        "responses": {
          "200": {"description": "Order is cancelled and holds are released.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderResponse"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"cookieAuth": {"type": "apiKey", "in": "cookie", "name": "datvexe_session"}},
    "parameters": {
      "CsrfToken": {"name": "X-CSRF-Token", "in": "header", "required": true, "schema": {"type": "string"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 128}},
      "MaDon": {"name": "maDon", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Id"}},
      "MaGhe": {"name": "maGhe", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Id"}}
    },
    "responses": {
      "BadRequest": {"description": "Invalid request or validation error.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Unauthorized": {"description": "Missing or expired session.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Forbidden": {"description": "Wrong role, CSRF failure, or caller does not own the order.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "NotFound": {"description": "Order, trip, or seat not found.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Conflict": {"description": "Seat unavailable, hold expired, invalid state, or idempotency conflict.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
    },
    "schemas": {
      "Id": {"type": "string", "minLength": 1, "maxLength": 40},
      "Timestamp": {"type": "string", "format": "date-time"},
      "DecimalMoney": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$", "description": "Exact decimal preview value; unlike T05 integer-VND contracts, no rounding or scale reduction occurs before T17 price freeze."},
      "HoldRequest": {
        "type": "object", "required": ["maChuyen", "danhSachMaGhe"],
        "properties": {"maChuyen": {"$ref": "#/components/schemas/Id"}, "danhSachMaGhe": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/components/schemas/Id"}}},
        "additionalProperties": false
      },
      "SeatHold": {
        "type": "object", "required": ["maGiuCho", "maGhe", "trangThai", "thoiDiemBatDau", "thoiDiemHetHan"],
        "properties": {"maGiuCho": {"$ref": "#/components/schemas/Id"}, "maGhe": {"$ref": "#/components/schemas/Id"}, "trangThai": {"type": "string", "enum": ["DANG_GIU", "DA_XAC_NHAN", "HET_HAN", "DA_HUY"]}, "thoiDiemBatDau": {"$ref": "#/components/schemas/Timestamp"}, "thoiDiemHetHan": {"$ref": "#/components/schemas/Timestamp"}},
        "additionalProperties": false
      },
      "HoldSeatResponse": {
        "type": "object", "required": ["maDon", "maChuyen", "trangThaiDon", "serverTime", "thoiDiemBatDau", "thoiDiemHetHan", "danhSachGheGiu", "danhSachGiuCho"],
        "properties": {"maDon": {"$ref": "#/components/schemas/Id"}, "maChuyen": {"$ref": "#/components/schemas/Id"}, "trangThaiDon": {"type": "string"}, "serverTime": {"$ref": "#/components/schemas/Timestamp"}, "thoiDiemBatDau": {"$ref": "#/components/schemas/Timestamp"}, "thoiDiemHetHan": {"$ref": "#/components/schemas/Timestamp"}, "danhSachGheGiu": {"type": "array", "items": {"$ref": "#/components/schemas/Id"}}, "danhSachGiuCho": {"type": "array", "items": {"$ref": "#/components/schemas/SeatHold"}}},
        "additionalProperties": false
      },
      "ContactPatch": {
        "type": "object", "minProperties": 1,
        "properties": {"khachDatTen": {"type": "string", "minLength": 1, "maxLength": 120}, "khachDatSoDienThoai": {"type": "string", "minLength": 1, "maxLength": 20}, "ghiChu": {"type": ["string", "null"], "maxLength": 500}},
        "additionalProperties": false
      },
      "Passenger": {
        "type": "object", "required": ["maGhe", "hoTen", "soDienThoai"],
        "properties": {"maGhe": {"$ref": "#/components/schemas/Id"}, "hoTen": {"type": "string", "minLength": 1, "maxLength": 120}, "soDienThoai": {"type": "string", "minLength": 1, "maxLength": 20}, "cccd": {"type": ["string", "null"], "maxLength": 20}},
        "additionalProperties": false
      },
      "PassengerUpdate": {"type": "object", "required": ["hanhKhach"], "properties": {"hanhKhach": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/components/schemas/Passenger"}}}, "additionalProperties": false},
      "SeatSwapRequest": {"type": "object", "required": ["maGheCu", "maGheMoi"], "properties": {"maGheCu": {"$ref": "#/components/schemas/Id"}, "maGheMoi": {"$ref": "#/components/schemas/Id"}}, "additionalProperties": false},
      "PromotionSelection": {"type": "object", "required": ["maKhuyenMai"], "properties": {"maKhuyenMai": {"type": "string", "minLength": 1, "maxLength": 40}}, "additionalProperties": false},
      "SeatHoldSummary": {"type": "object", "required": ["maGiuCho", "maGhe", "trangThai", "thoiDiemBatDau", "thoiDiemHetHan"], "properties": {"maGiuCho": {"$ref": "#/components/schemas/Id"}, "maGhe": {"$ref": "#/components/schemas/Id"}, "trangThai": {"type": "string"}, "thoiDiemBatDau": {"$ref": "#/components/schemas/Timestamp"}, "thoiDiemHetHan": {"$ref": "#/components/schemas/Timestamp"}}, "additionalProperties": false},
      "OrderTicket": {"type": "object", "required": ["maVe", "maGhe", "hoTen", "soDienThoai", "cccd", "giaVe", "trangThai", "ngayXuatVe"], "properties": {"maVe": {"$ref": "#/components/schemas/Id"}, "maGhe": {"$ref": "#/components/schemas/Id"}, "hoTen": {"type": "string", "minLength": 1, "maxLength": 120}, "soDienThoai": {"type": "string", "minLength": 1, "maxLength": 20}, "cccd": {"type": ["string", "null"]}, "giaVe": {"$ref": "#/components/schemas/DecimalMoney"}, "trangThai": {"type": "string", "enum": ["DA_XUAT_VE", "DA_LEN_XE", "DA_HOAN", "DA_HUY"]}, "ngayXuatVe": {"anyOf": [{"$ref": "#/components/schemas/Timestamp"}, {"type": "null"}]}}, "additionalProperties": false},
      "PricePreview": {"type": "object", "required": ["tongTienGoc", "tienGiam", "tongThanhToan", "maKhuyenMaiDaChon", "maKhuyenMaiApDung", "lyDoKhongApDung"], "properties": {"tongTienGoc": {"$ref": "#/components/schemas/DecimalMoney"}, "tienGiam": {"$ref": "#/components/schemas/DecimalMoney"}, "tongThanhToan": {"$ref": "#/components/schemas/DecimalMoney"}, "maKhuyenMaiDaChon": {"type": ["string", "null"]}, "maKhuyenMaiApDung": {"type": ["string", "null"]}, "lyDoKhongApDung": {"type": ["string", "null"]}}, "additionalProperties": false},
      "PriceLine": {"type": "object", "required": ["maGhe", "giaGoc", "tienGiam", "thanhTien"], "properties": {"maGhe": {"$ref": "#/components/schemas/Id"}, "giaGoc": {"$ref": "#/components/schemas/DecimalMoney"}, "tienGiam": {"$ref": "#/components/schemas/DecimalMoney"}, "thanhTien": {"$ref": "#/components/schemas/DecimalMoney"}}, "additionalProperties": false},
      "FrozenPrice": {"type": "object", "required": ["donViTienTe", "tongTienGoc", "tongTienGiam", "tongThanhToan", "chiTietGia"], "properties": {"donViTienTe": {"type": "string", "const": "VND"}, "tongTienGoc": {"$ref": "#/components/schemas/DecimalMoney"}, "tongTienGiam": {"$ref": "#/components/schemas/DecimalMoney"}, "tongThanhToan": {"$ref": "#/components/schemas/DecimalMoney"}, "chiTietGia": {"type": "array", "items": {"$ref": "#/components/schemas/PriceLine"}}}, "additionalProperties": false},
      "OrderResponse": {
        "type": "object", "description": "hanhKhach is a normalized passenger snapshot from the current authenticated account and JSESSIONID; a fresh HTTP session returns an empty array. PATCH idempotency data in PostgreSQL redacts hanhKhach/coTheChotGia. A complete PATCH replay is available only if its response was written and remains in the current HTTP session; the cache may be absent after a crash between database commit and session write or after session loss, in which case retry returns the redacted database order state. Expiry commits the hold and order as HET_HAN before returning 409 HOLD_EXPIRED. danhSachVe always stays empty before T17/T18 issuance. T16 never creates a ticket draft or HanhKhach database entity.",
        "required": ["maDon", "maChuyen", "trangThaiDon", "khachDatTen", "khachDatSoDienThoai", "ghiChu", "serverTime", "thoiDiemBatDau", "thoiDiemHetHan", "danhSachGiuCho", "hanhKhach", "danhSachVe", "giaTamTinh", "coTheChotGia", "giaDaChot", "thongBao"],
        "properties": {"maDon": {"$ref": "#/components/schemas/Id"}, "maChuyen": {"$ref": "#/components/schemas/Id"}, "trangThaiDon": {"type": "string"}, "khachDatTen": {"type": "string", "minLength": 1, "maxLength": 120}, "khachDatSoDienThoai": {"type": "string", "minLength": 1, "maxLength": 20}, "ghiChu": {"type": ["string", "null"], "maxLength": 500}, "serverTime": {"$ref": "#/components/schemas/Timestamp"}, "thoiDiemBatDau": {"anyOf": [{"$ref": "#/components/schemas/Timestamp"}, {"type": "null"}]}, "thoiDiemHetHan": {"anyOf": [{"$ref": "#/components/schemas/Timestamp"}, {"type": "null"}]}, "danhSachGiuCho": {"type": "array", "items": {"$ref": "#/components/schemas/SeatHoldSummary"}}, "hanhKhach": {"type": "array", "items": {"$ref": "#/components/schemas/Passenger"}}, "danhSachVe": {"type": "array", "items": {"$ref": "#/components/schemas/OrderTicket"}, "description": "Always empty until a ticket is actually issued."}, "giaTamTinh": {"$ref": "#/components/schemas/PricePreview"}, "coTheChotGia": {"type": "boolean", "description": "False until the current HTTP session has a valid passenger for every held seat."}, "giaDaChot": {"anyOf": [{"$ref": "#/components/schemas/FrozenPrice"}, {"type": "null"}], "description": "Null before freeze or after the order is closed; frozen snapshot has no quote version or quote timestamp."}, "thongBao": {"type": "array", "items": {"type": "string"}}},
        "additionalProperties": false
      },
      "ErrorResponse": {"type": "object", "required": ["code", "message", "details", "timestamp", "traceId"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}, "timestamp": {"$ref": "#/components/schemas/Timestamp"}, "traceId": {"type": "string"}}, "additionalProperties": false}
    }
  }
}
