      },
      "put": {
        "tags": [
          "Khuyến mãi"
        ],
        "operationId": "updateKhuyenMai",
        "summary": "Cập nhật khuyến mãi",
        "description": "Chỉ ADMIN. Thay toàn bộ trường sửa được, mã lấy từ URL. ngayKetThuc phải sau ngayBatDau. Mã đã được sử dụng hoặc tham chiếu trong đơn đặt vé trả 409 để bảo vệ lịch sử; không cập nhật soLuongDaDung qua API này.",
        "x-roles": [
          "ADMIN"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromotionUpdateRequest"
              },
              "example": {
                "tenKhuyenMai": "Ưu đãi tháng 10",
                "moTa": "Áp dụng tháng 10.",
                "loaiGiam": "SO_TIEN_CO_DINH",
                "giaTriGiam": "50000",
                "giamToiDa": null,
                "donToiThieu": "300000",
                "soLuong": 600,
                "ngayBatDau": "2026-10-01T00:00:00+07:00",
                "ngayKetThuc": "2026-10-31T23:59:59+07:00"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PromotionItem"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "409": {
            "$ref": "#/components/responses/PromotionConflict"
          }
        }
      },
      "delete": {
        "tags": [
          "Khuyến mãi"
        ],
        "operationId": "deleteKhuyenMai",
        "summary": "Xóa khuyến mãi",
        "description": "Chỉ ADMIN. Chỉ trả 409 nếu khuyến mãi đã được sử dụng hoặc tham chiếu.",
        "x-roles": [
          "ADMIN"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "204": {
            "$ref": "#/components/responses/NoContent"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/PromotionInUse"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
