  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "datvexe_session",
        "description": "Cookie phiên HttpOnly do AuthFilter phát hành; Path=/api, SameSite=Lax."
      }
    },
    "headers": {
      "TraceId": {
        "description": "Mã truy vết; khớp traceId trong lỗi JSON.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameters": {
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "description": "Lấy từ đăng nhập hoặc GET /api/tai-khoan/me.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "MaKhuyenMai": {
        "name": "maKhuyenMai",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{1,40}$",
          "maxLength": 40
        }
      },
      "MaPhuongThuc": {
        "name": "maPhuongThuc",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{1,40}$",
          "maxLength": 40
        }
      }
    },
    "responses": {
      "PromotionList": {
        "description": "Trang khuyến mãi. totalItems và totalPages là 0 chỉ khi không có kết quả phù hợp; page vượt trang cuối trả items rỗng và giữ nguyên tổng.",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PromotionPage"
            },
            "examples": {
              "matchingResults": {
                "summary": "Trang có kết quả",
                "value": {
                  "items": [
                    {
                      "maKhuyenMai": "KM2026",
                      "tenKhuyenMai": "Ưu đãi tháng 10",
                      "moTa": "Giảm giá tháng 10.",
                      "loaiGiam": "PHAN_TRAM",
                      "giaTriGiam": 15,
                      "giamToiDa": "100000",
                      "donToiThieu": "300000",
                      "soLuong": 500,
                      "soLuongDaDung": 42,
                      "ngayBatDau": "2026-10-01T00:00:00+07:00",
                      "ngayKetThuc": "2026-10-31T23:59:59+07:00",
                      "trangThai": "HOAT_DONG"
                    }
                  ],
                  "page": 1,
                  "size": 20,
                  "totalItems": 1,
                  "totalPages": 1
                }
              },
              "beyondLastPage": {
                "summary": "Trang vượt trang cuối giữ nguyên tổng",
                "value": {
                  "items": [],
                  "page": 3,
                  "size": 20,
                  "totalItems": 21,
                  "totalPages": 2
                }
              },
              "noMatches": {
                "summary": "Không có kết quả phù hợp",
                "value": {
                  "items": [],
                  "page": 1,
                  "size": 20,
                  "totalItems": 0,
                  "totalPages": 0
                }
              }
