{
  "openapi": "3.0.3",
  "info": {
    "title": "Khuyến mãi và phương thức thanh toán API",
    "version": "0.1.0",
    "description": "API Servlet/JPA quản lý khuyến mãi và danh mục phương thức thanh toán. Không gồm đặt chỗ, cổng thanh toán, giữ lượt hoặc frontend."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Backend phát triển. Các path đã bao gồm tiền tố /api."
    }
  ],
  "tags": [
    {
      "name": "Khuyến mãi"
    },
    {
      "name": "Phương thức thanh toán"
    }
  ],
  "paths": {
    "/api/quan-tri/khuyen-mai": {
      "get": {
        "tags": [
          "Khuyến mãi"
        ],
        "operationId": "listKhuyenMai",
        "summary": "Danh sách khuyến mãi",
        "description": "Chỉ ADMIN. Trả trang khuyến mãi. page bắt đầu từ 1, mặc định 1; size từ 1 đến 100, mặc định 20. tuNgay và denNgay lọc ngày lịch của ngayBatDau theo Asia/Ho_Chi_Minh, bao gồm cả hai ngày. Sắp xếp ổn định theo ngayBatDau giảm dần rồi maKhuyenMai tăng dần; không nhận tham số sort.",
        "x-roles": [
          "ADMIN"
        ],
        "parameters": [
          {
            "name": "tuKhoa",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "trangThai",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/PromotionStatus"
            }
          },
          {
            "name": "tuNgay",
            "in": "query",
            "description": "Ngày bắt đầu lọc theo ngày lịch của ngayBatDau tại Asia/Ho_Chi_Minh; bao gồm ngày này.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "denNgay",
            "in": "query",
            "description": "Ngày kết thúc lọc theo ngày lịch của ngayBatDau tại Asia/Ho_Chi_Minh; bao gồm ngày này.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Số trang, bắt đầu từ 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Số phần tử mỗi trang.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/PromotionList"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": [
          "Khuyến mãi"
        ],
        "operationId": "createKhuyenMai",
        "summary": "Tạo khuyến mãi",
        "description": "Chỉ ADMIN. Mã phải duy nhất; ngayKetThuc phải sau ngayBatDau. Với PHAN_TRAM, giaTriGiam tối đa 100.",
        "x-roles": [
          "ADMIN"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromotionCreateRequest"
              },
              "example": {
                "maKhuyenMai": "KM2026",
                "tenKhuyenMai": "Ưu đãi tháng 10",
                "moTa": "Giảm giá chuyến đi tháng 10.",
                "loaiGiam": "PHAN_TRAM",
                "giaTriGiam": 15,
                "giamToiDa": "100000",
                "donToiThieu": "300000",
                "soLuong": 500,
                "ngayBatDau": "2026-10-01T00:00:00+07:00",
                "ngayKetThuc": "2026-10-31T23:59:59+07:00"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/PromotionCreated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "409": {
            "$ref": "#/components/responses/DuplicateCode"
          }
        }
      }
    },
