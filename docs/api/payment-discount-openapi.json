        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          },
          "Location": {
            "description": "Đường dẫn tra cứu khuyến mãi vừa tạo.",
            "schema": {
              "type": "string",
              "format": "uri-reference",
